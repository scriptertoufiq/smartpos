# ---------------------------------------------------------------------------
# SmartPOS environment
#
# Copy to .env and adjust:   cp .env.example .env
# .env is git-ignored and must never be committed.
#
# Nothing in the codebase reads os.environ directly -- everything goes through
# smartpos.config.get_settings(), so this file is the single place that decides
# where the app connects and where it writes.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# DB_HOST is 127.0.0.1 when MySQL runs in Docker on this machine, or the shop
# server's LAN address when several counters share one database.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smartpos
DB_USER=smartpos
DB_PASSWORD=smartpos
# Connections held open. 5 is ample for one terminal; raise it only if a single
# machine runs several windows.
DB_POOL_SIZE=5

# Used only by the MySQL container in docker-compose.yml, never by the app.
MYSQL_ROOT_PASSWORD=root

# Tests must never run against the development database -- they roll back, but
# a mistake here destroys real data.
TEST_DB_NAME=smartpos_test

# --- Application -----------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
LOG_DIR=./logs

# Where BackupService writes dumps.
BACKUP_DIR=./backups

# mysqldump / mysql executables. Leave blank to use whatever is on PATH; set an
# absolute path on Windows, where MySQL's bin directory usually is not on it.
# e.g. C:/Program Files/MySQL/MySQL Server 8.0/bin/mysqldump.exe
MYSQLDUMP_PATH=
MYSQL_CLIENT_PATH=

# --- Business defaults -----------------------------------------------------
# Used to seed a fresh database. Once the shop is running, these live in the
# `settings` table and are edited from the Settings screen -- change them there,
# not here, or the two will disagree.
CURRENCY_SYMBOL=BDT
DEFAULT_TAX_RATE=0.0
