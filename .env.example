# Copy to .env and adjust. .env is git-ignored.

# --- Database -------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smartpos
DB_USER=smartpos
DB_PASSWORD=smartpos
DB_POOL_SIZE=5

# Root password used only by the MySQL container (docker-compose).
MYSQL_ROOT_PASSWORD=root

# --- Application ----------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# Directory where database backups are written.
BACKUP_DIR=./backups

# --- Business defaults ----------------------------------------------------
CURRENCY_SYMBOL=BDT
DEFAULT_TAX_RATE=0.0
