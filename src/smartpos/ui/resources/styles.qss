/* SmartPOS Qt stylesheet.
   Loaded by main.py after the QApplication is created. */

QMainWindow {
    background: #f5f6f8;
}

/* Sidebar navigation */
#sidebar {
    background: #1f2937;
    min-width: 200px;
}

#sidebar QPushButton {
    color: #d1d5db;
    background: transparent;
    border: none;
    padding: 12px 16px;
    text-align: left;
    font-size: 14px;
}

#sidebar QPushButton:hover {
    background: #374151;
    color: #ffffff;
}

#sidebar QPushButton:checked {
    background: #2563eb;
    color: #ffffff;
}

/* Tables */
QTableView {
    background: #ffffff;
    gridline-color: #e5e7eb;
    selection-background-color: #dbeafe;
    selection-color: #111827;
}

QHeaderView::section {
    background: #f3f4f6;
    padding: 6px;
    border: none;
    border-bottom: 1px solid #e5e7eb;
    font-weight: 600;
}

/* Primary action button */
QPushButton[primary="true"] {
    background: #2563eb;
    color: #ffffff;
    border-radius: 4px;
    padding: 8px 18px;
    font-weight: 600;
}

QPushButton[primary="true"]:hover {
    background: #1d4ed8;
}

/* ---------------------------------------------------------------- shell */
#brand {
    color: #ffffff;
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 0.4px;
}

#sidebarRule { color: #374151; background: #374151; max-height: 1px; }

#sidebarUser { color: #9ca3af; font-size: 12px; }

#signOut {
    color: #d1d5db;
    background: transparent;
    border: none;
    padding: 8px 18px;
    text-align: left;
    font-size: 13px;
}
#signOut:hover { background: #7f1d1d; color: #ffffff; }

#contentStack { background: #f5f6f8; }

#viewHeading {
    font-size: 21px;
    font-weight: 700;
    color: #111827;
}

#hintLabel { color: #6b7280; font-size: 12px; }

#pendingBadge {
    color: #92400e;
    background: #fef3c7;
    border: 1px solid #fcd34d;
    border-radius: 3px;
    padding: 4px 10px;
    font-size: 12px;
}

/* ---------------------------------------------------------------- login */
QDialog { background: #ffffff; }

#loginTitle {
    font-size: 26px;
    font-weight: 700;
    color: #111827;
}
#loginSubtitle { color: #6b7280; font-size: 13px; }
#loginRule { color: #e5e7eb; background: #e5e7eb; max-height: 1px; }
#loginFooter { color: #9ca3af; font-size: 11px; }
#loginError {
    color: #b91c1c;
    background: #fee2e2;
    border: 1px solid #fca5a5;
    border-radius: 3px;
    padding: 7px 10px;
    font-size: 12px;
}

/* --------------------------------------------------------------- inputs */
QLineEdit, QComboBox {
    background: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 13px;
    color: #111827;
}
QLineEdit:focus, QComboBox:focus { border: 1px solid #2563eb; }
QLineEdit::placeholder { color: #9ca3af; }

QPushButton {
    background: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    padding: 7px 16px;
    font-size: 13px;
    color: #111827;
}
QPushButton:hover:enabled { background: #f3f4f6; }
QPushButton:disabled { color: #9ca3af; background: #f9fafb; border-color: #e5e7eb; }
QPushButton[danger="true"]:enabled { color: #b91c1c; border-color: #fca5a5; }
QPushButton[danger="true"]:hover:enabled { background: #fee2e2; }

QTableView { border: 1px solid #e5e7eb; border-radius: 4px; }
QTableView::item { padding: 5px; }
QStatusBar { background: #ffffff; border-top: 1px solid #e5e7eb; color: #6b7280; }
QStatusBar QLabel { color: #6b7280; font-size: 12px; }

/* ------------------------------------------------- full-screen login */
#loginWindow { background: #eef1f5; }

#loginCard {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
}

#warehousePicker {
    padding: 2px 8px;
    font-size: 12px;
    min-height: 22px;
}
