/* SmartPOS Qt stylesheet.
   Loaded by main.py after the QApplication is created. */

QMainWindow {
    background: #f5f6f8;
}

/* Sidebar navigation */
#sidebar {
    background: #1f2937;
    min-width: 200px;
}

#sidebar QPushButton {
    color: #d1d5db;
    background: transparent;
    border: none;
    padding: 12px 16px;
    text-align: left;
    font-size: 14px;
}

#sidebar QPushButton:hover {
    background: #374151;
    color: #ffffff;
}

#sidebar QPushButton:checked {
    background: #2563eb;
    color: #ffffff;
}

/* Tables */
QTableView {
    background: #ffffff;
    gridline-color: #e5e7eb;
    selection-background-color: #dbeafe;
    selection-color: #111827;
}

QHeaderView::section {
    background: #f3f4f6;
    padding: 6px;
    border: none;
    border-bottom: 1px solid #e5e7eb;
    font-weight: 600;
}


/* ---------------------------------------------------------------- shell */
#brand {
    color: #ffffff;
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 0.4px;
}

#sidebarRule { color: #374151; background: #374151; max-height: 1px; }

#sidebarUser { color: #9ca3af; font-size: 12px; }

#signOut {
    color: #d1d5db;
    background: transparent;
    border: none;
    padding: 8px 18px;
    text-align: left;
    font-size: 13px;
}
#signOut:hover { background: #7f1d1d; color: #ffffff; }

#contentStack { background: #f5f6f8; }

#viewHeading {
    font-size: 21px;
    font-weight: 700;
    color: #111827;
}

#hintLabel { color: #6b7280; font-size: 12px; }

#pendingBadge {
    color: #92400e;
    background: #fef3c7;
    border: 1px solid #fcd34d;
    border-radius: 3px;
    padding: 4px 10px;
    font-size: 12px;
}

/* ---------------------------------------------------------------- login */
QDialog { background: #ffffff; }

#loginTitle {
    font-size: 26px;
    font-weight: 700;
    color: #111827;
}
#loginSubtitle { color: #6b7280; font-size: 13px; }
#loginRule { color: #e5e7eb; background: #e5e7eb; max-height: 1px; }
#loginFooter { color: #9ca3af; font-size: 11px; }
#loginError {
    color: #b91c1c;
    background: #fee2e2;
    border: 1px solid #fca5a5;
    border-radius: 3px;
    padding: 7px 10px;
    font-size: 12px;
}

/* --------------------------------------------------------------- inputs */
QLineEdit, QComboBox {
    background: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 13px;
    color: #111827;
}
QLineEdit:focus, QComboBox:focus { border: 1px solid #2563eb; }
QLineEdit::placeholder { color: #9ca3af; }

QPushButton {
    background: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    padding: 7px 16px;
    font-size: 13px;
    color: #111827;
}
QPushButton:hover:enabled { background: #f3f4f6; }
QPushButton:disabled { color: #9ca3af; background: #f9fafb; border-color: #e5e7eb; }

QTableView { border: 1px solid #e5e7eb; border-radius: 4px; }
QTableView::item { padding: 5px; }
QStatusBar { background: #ffffff; border-top: 1px solid #e5e7eb; color: #6b7280; }
QStatusBar QLabel { color: #6b7280; font-size: 12px; }

/* ------------------------------------------------- full-screen login */
#loginWindow { background: #eef1f5; }

#loginCard {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
}

#warehousePicker {
    padding: 2px 8px;
    font-size: 12px;
    min-height: 22px;
}

#panelHeading { font-size: 13px; font-weight: 600; color: #374151; }
#balanceStrong { font-size: 16px; font-weight: 700; color: #b91c1c; }

/* ------------------------------------------------------------ POS counter */
#posEntry {
    font-size: 16px;
    border: 2px solid #2563eb;
    padding: 6px 12px;
}
#posTotals {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
    min-width: 260px;
}
#posTotal { font-size: 30px; font-weight: 700; color: #111827; }
#posChange { font-size: 15px; font-weight: 600; color: #047857; }
#posComplete {
    background: #16a34a;
    color: #ffffff;
    font-size: 15px;
    font-weight: 700;
    border: none;
    border-radius: 5px;
}
#posComplete:hover:enabled { background: #15803d; }
#posComplete:disabled { background: #d1d5db; color: #9ca3af; }

/* --------------------------------------------------------- dashboard */
#statTile {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
}
#statCaption { color: #6b7280; font-size: 11px; }
#statValue   { color: #111827; font-size: 22px; font-weight: 700; }
#statDetail  { color: #9ca3af; font-size: 11px; }
#panelCard {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
}

/* ----------------------------------------------------- button variants
   These come last and carry an extra pseudo-state on purpose.

   `QPushButton[primary="true"]:hover` and `QPushButton:hover:enabled` have the
   same specificity under the CSS rules Qt follows (one attribute + one pseudo
   against two pseudos), so whichever is written later wins. The generic rule
   was later, and hovering the blue Sign in button turned it pale grey while the
   text stayed white -- the label vanished.

   Adding `:enabled` makes these variants strictly more specific, so they win on
   their own merit and not on where they happen to sit in the file. */

QPushButton[primary="true"]:enabled {
    background: #2563eb;
    color: #ffffff;
    border: 1px solid #2563eb;
    border-radius: 4px;
    padding: 8px 18px;
    font-weight: 600;
}
QPushButton[primary="true"]:hover:enabled {
    background: #1d4ed8;
    border-color: #1d4ed8;
    color: #ffffff;
}
QPushButton[primary="true"]:pressed:enabled {
    background: #1e40af;
    border-color: #1e40af;
    color: #ffffff;
}
QPushButton[primary="true"]:focus:enabled {
    border: 1px solid #1e3a8a;
}
QPushButton[primary="true"]:disabled {
    background: #cbd5e1;
    border-color: #cbd5e1;
    color: #ffffff;
}

QPushButton[danger="true"]:enabled {
    color: #b91c1c;
    border-color: #fca5a5;
    background: #ffffff;
}
QPushButton[danger="true"]:hover:enabled {
    background: #fee2e2;
    color: #991b1b;
    border-color: #f87171;
}
QPushButton[danger="true"]:pressed:enabled {
    background: #fecaca;
}

/* ------------------------------------------------- text that must not vanish
   Qt gives a plain QLabel its colour from the desktop palette. On a machine in
   dark mode that is near-white, and these surfaces are hard-coded white -- the
   text disappears. Every text widget is given an explicit colour so nothing
   depends on a system setting. (main.py also installs a light palette; this is
   the belt to that pair of braces.) */

QWidget { color: #111827; }
QLabel { color: #111827; }
QCheckBox, QRadioButton, QGroupBox { color: #111827; }
QFormLayout QLabel { color: #111827; }
QTableWidget, QTreeWidget, QListWidget { color: #111827; }
QHeaderView::section { color: #374151; }
QMenuBar, QMenu { background: #ffffff; color: #111827; }
QMenu::item:selected { background: #2563eb; color: #ffffff; }
QToolTip { background: #111827; color: #ffffff; border: none; padding: 4px 8px; }
QDateEdit, QDoubleSpinBox, QSpinBox {
    background: #ffffff;
    color: #111827;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    padding: 4px 8px;
}
QSplitter::handle { background: #e5e7eb; }

/* ------------------------------------------- POS product suggestions
   Drawn over the cart, so it needs a solid background and a real border --
   anything translucent would show the table rows through the text. */
#posSuggest {
    background: #ffffff;
    border: 1px solid #2563eb;
    border-top: none;
    border-radius: 0 0 4px 4px;
    color: #111827;
    font-size: 13px;
    outline: none;
}
#posSuggest::item { padding: 7px 10px; border-bottom: 1px solid #f3f4f6; }
#posSuggest::item:selected { background: #2563eb; color: #ffffff; }
#posSuggest::item:hover { background: #dbeafe; color: #111827; }

/* --------------------------------------- POS cart quantity stepper */
#cartStep {
    background: #f3f4f6;
    border: 1px solid #d1d5db;
    border-radius: 3px;
    padding: 0;
    font-size: 14px;
    font-weight: 700;
    color: #374151;
}
#cartStep:hover:enabled { background: #dbeafe; border-color: #2563eb; color: #1d4ed8; }
#cartStep:pressed:enabled { background: #bfdbfe; }
