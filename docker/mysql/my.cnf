[mysqld]
character-set-server = utf8mb4
collation-server     = utf8mb4_unicode_ci

# POS work is transactional: every sale writes a sale row, its line items and a
# stock movement together. Keep the engine and isolation level explicit.
default-storage-engine = InnoDB
transaction-isolation  = READ-COMMITTED

# Store money as DECIMAL and dates in the shop's own timezone.
sql-mode = STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION

max_connections = 100

[client]
default-character-set = utf8mb4
